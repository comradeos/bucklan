# Абсолютний шлях до папки або шлях відносно цього файла.
# Наприклад, /Users/me/Projects/work або C:/Users/me/Projects/work.
BUCKLAN_ROOT=

# Порт для команд serve, ping, list, get і sync. Без цього рядка використовується 8765.
BUCKLAN_PORT=8765

# Для команд list, get і sync задай однаковий токен на обох ноутбуках.
# BUCKLAN_TOKEN=
